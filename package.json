    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/public-sans": "^5.2.7",
    "lucide-react": "^1.17.0",
