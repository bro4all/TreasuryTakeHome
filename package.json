{
  "name": "treasury-label-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "node scripts/vendor-ocr-assets.mjs",
    "vendor-assets": "node scripts/vendor-ocr-assets.mjs",
    "predev": "node scripts/vendor-ocr-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/vendor-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
